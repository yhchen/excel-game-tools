{
  "IncludeFilesAndPath": [
    "./test/fixtures/positive/BasicTypes.csv"
  ],
  "GroupMap": {
    "*": "(All) Default value",
    "A": "All test",
    "S": "Server",
    "C": "Client"
  },
  "Export": [
    {
      "type": "protobuf-net",
      "OutputDir": "./test/tmp/positive-csharp-no-namespace/",
      "GroupFilter": [
        "*"
      ],
      "ExportTemple": "[Config()]\npublic partial class {name}Category : ACategory<{name}>{}\n\n{classDef}: IConfig\n{data}\n",
      "UseNamespace": [
        "ETModel"
      ],
      "ExportEnum": true,
      "UseDefaultValueIfEmpty": true
    }
  ],
  "see: http://momentjs.com/docs/#/parsing/string-format/": null,
  "DateFmt": "YYYY/MM/DD HH:mm:ss",
  "cm21": "relative to ${cwd} or absolute path",
  "TypeCheckerJSFilePath": "./test/fixtures/typeDefs/positive-typeDef.js",
  "TinyDateFmt": "YYYY/MM/DD",
  "TimeStampUseMS": true,
  "cm22": "custom defined data, can be null",
  "LineBreak": "\n",
  "FractionDigitsFMT": 6,
  "EnableDebugOutput": false,
  "ArraySpliter": [
    ",",
    ";",
    "\n"
  ]
}
